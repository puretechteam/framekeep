+static int64_t vvenc_real_ts(VVenCContext *s, int64_t n)
+{
+    if (n < s->pts_map_base)
+        return s->first_pts + (n < 0 ? n : 0) * s->frame_dur;
+    if (n - s->pts_map_base < s->pts_map_len)
+        return s->pts_map[n - s->pts_map_base];
+    return s->pts_map_len ? s->pts_map[s->pts_map_len - 1] + (n - s->pts_map_base - s->pts_map_len + 1) * s->frame_dur
+                          : s->first_pts + n * s->frame_dur;
+}
+
+static int vvenc_remember_pts(AVCodecContext *avctx, VVenCContext *s, int64_t pts)
+{
+    if (!s->frames_in) {
+        s->first_pts = pts;
+        s->frame_dur = 1;
+        if (avctx->framerate.num > 0 && avctx->framerate.den > 0)
+            s->frame_dur = FFMAX(1, av_rescale_q(1, av_inv_q(avctx->framerate), avctx->time_base));
+    }
+    if (s->pts_map_len == s->pts_map_size) {
+        int size = FFMAX(64, s->pts_map_size * 2);
+        int64_t *map = av_realloc_array(s->pts_map, size, sizeof(*map));
+        if (!map)
+            return AVERROR(ENOMEM);
+        s->pts_map = map;
+        s->pts_map_size = size;
+    }
+    s->pts_map[s->pts_map_len++] = pts;
+    return 0;
+}
+
+static void vvenc_forget_pts(VVenCContext *s, int64_t before)
+{
+    /* decode order: later packets never show or decode before this packet's decode time */
+    int drop = FFMIN(s->pts_map_len, (int)FFMAX(0, before - s->pts_map_base));
+    if (drop > 0) {
+        memmove(s->pts_map, s->pts_map + drop, (s->pts_map_len - drop) * sizeof(*s->pts_map));
+        s->pts_map_len  -= drop;
+        s->pts_map_base += drop;
+    }
+}
